{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-work.local/schemas/response.schema.json",
  "title": "CoreRuntime JSON Response",
  "oneOf": [
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "apiVersion", "data", "warnings"],
      "properties": {
        "ok": { "const": true },
        "apiVersion": { "const": "1.0" },
        "taskId": { "type": "string" },
        "revision": { "type": "integer", "minimum": 0 },
        "data": {},
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "dependentRequired": {
        "taskId": ["revision"],
        "revision": ["taskId"]
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "apiVersion", "error"],
      "properties": {
        "ok": { "const": false },
        "apiVersion": { "const": "1.0" },
        "taskId": { "type": "string" },
        "revision": { "type": "integer", "minimum": 0 },
        "error": { "$ref": "#/$defs/error" }
      },
      "dependentRequired": {
        "taskId": ["revision"],
        "revision": ["taskId"]
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "blockers", "remediation"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_ARGUMENT", "SCHEMA_VERSION_UNSUPPORTED", "TASK_NOT_FOUND", "TASK_AMBIGUOUS",
            "REVISION_CONFLICT", "ILLEGAL_TRANSITION", "GATE_BLOCKED", "WORK_ITEM_CONFLICT",
            "STATE_CORRUPT", "LOCK_UNAVAILABLE", "PLATFORM_UNAVAILABLE", "INTERNAL_ERROR"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" } },
        "remediation": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "diagnosticId": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "code": { "const": "INTERNAL_ERROR" } }, "required": ["code"] },
          "then": { "required": ["diagnosticId"] }
        },
        {
          "if": { "properties": { "code": { "const": "GATE_BLOCKED" } }, "required": ["code"] },
          "then": {
            "properties": {
              "blockers": { "type": "array", "minItems": 1 },
              "remediation": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "kind", "path", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "expected": {},
        "actual": {}
      }
    }
  }
}
