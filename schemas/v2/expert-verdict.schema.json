{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-work-runtime.dev/schemas/v2/expert-verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "rationale", "evidenceRefs", "affectedScope", "risks", "confidence", "recommendedAction"],
  "properties": {
    "outcome": { "enum": ["accept", "rework", "choose-option", "need-more-evidence", "escalate-to-user"] },
    "rationale": { "type": "string", "minLength": 1 },
    "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "affectedScope": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "risks": { "type": "array", "items": { "type": "string" } },
    "confidence": { "enum": ["low", "medium", "high"] },
    "recommendedAction": { "type": "string", "minLength": 1 }
  }
}
