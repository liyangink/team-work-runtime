{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-work.local/schemas/binding.schema.json",
  "title": "Team-work Session Binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "platform", "sessionKey", "taskId", "revision", "boundAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "platform": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "sessionKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "taskId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "revision": { "type": "integer", "minimum": 0 },
    "boundAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
