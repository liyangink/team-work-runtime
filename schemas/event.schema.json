{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-work.local/schemas/event.schema.json",
  "title": "Team-work Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "taskId", "type", "actor", "occurredAt", "revision", "refs"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "eventId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "taskId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "type": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$" },
    "actor": { "type": "string", "minLength": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "revision": { "type": "integer", "minimum": 0 },
    "reason": { "type": "string" },
    "refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
