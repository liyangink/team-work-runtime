{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-work-runtime.dev/schemas/v2/spec-provider",
  "$defs": {
    "taskRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "taskId", "stageRunId", "configDigest", "routeStateDigest"],
      "properties": {
        "providerId": { "type": "string", "minLength": 1 },
        "taskId": { "type": "string", "minLength": 1 },
        "stageRunId": { "type": "string", "minLength": 1 },
        "configDigest": { "type": "string", "minLength": 1 },
        "routeStateDigest": { "type": "string", "minLength": 1 }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "status", "observedAt"],
      "properties": {
        "providerId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["ready", "missing"] },
        "version": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "prepareIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "effectDigest", "task", "artifact"],
      "properties": {
        "operationId": { "type": "string", "minLength": 1 },
        "effectDigest": { "type": "string", "minLength": 1 },
        "task": { "$ref": "#/$defs/taskRef" },
        "artifact": { "enum": ["proposal", "design", "specs", "tasks"] },
        "capabilityNames": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "effectDigest", "capabilityId", "capabilityDigest", "task", "instructionsRef", "readableRefs", "writableRefs", "status"],
      "properties": {
        "operationId": { "type": "string", "minLength": 1 },
        "effectDigest": { "type": "string", "minLength": 1 },
        "capabilityId": { "type": "string", "minLength": 1 },
        "capabilityDigest": { "type": "string", "minLength": 1 },
        "task": { "$ref": "#/$defs/taskRef" },
        "instructionsRef": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/projectPath" },
        "readableRefs": { "type": "array", "items": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/projectPath" }, "uniqueItems": true },
        "writableRefs": { "type": "array", "items": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/projectPath" }, "uniqueItems": true },
        "status": { "enum": ["ready", "blocked", "in-doubt"] }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "providerRevision", "state", "readyArtifacts", "artifactRefs", "blockers"],
      "properties": {
        "task": { "$ref": "#/$defs/taskRef" },
        "providerRevision": { "type": "string", "minLength": 1 },
        "state": { "enum": ["not-started", "in-progress", "complete", "blocked"] },
        "readyArtifacts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "artifactRefs": { "type": "array", "items": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/projectPath" }, "uniqueItems": true },
        "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "providerRevision", "valid", "complete", "evidenceRefs", "blockers"],
      "properties": {
        "task": { "$ref": "#/$defs/taskRef" },
        "providerRevision": { "type": "string", "minLength": 1 },
        "valid": { "type": "boolean" },
        "complete": { "type": "boolean" },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "archiveIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "effectDigest", "task", "expectedProviderRevision"],
      "properties": {
        "operationId": { "type": "string", "minLength": 1 },
        "effectDigest": { "type": "string", "minLength": 1 },
        "task": { "$ref": "#/$defs/taskRef" },
        "expectedProviderRevision": { "type": "string", "minLength": 1 }
      }
    },
    "archiveReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "effectDigest", "task", "status", "archiveRefs", "observedAt"],
      "properties": {
        "operationId": { "type": "string", "minLength": 1 },
        "effectDigest": { "type": "string", "minLength": 1 },
        "task": { "$ref": "#/$defs/taskRef" },
        "status": { "enum": ["confirmed", "blocked", "in-doubt"] },
        "archiveRefs": { "type": "array", "items": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/projectPath" }, "uniqueItems": true },
        "observedAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "confirmed" } }, "required": ["status"] },
          "then": { "required": ["result"] }
        },
        {
          "if": { "properties": { "status": { "const": "missing" } }, "required": ["status"] },
          "then": { "not": { "required": ["result"] } }
        }
      ]
    },
    "inspectIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "effectDigest", "kind", "task"],
      "properties": {
        "operationId": { "type": "string", "minLength": 1 },
        "effectDigest": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["prepare", "archive"] },
        "task": { "$ref": "#/$defs/taskRef" }
      }
    },
    "operationInspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "effectDigest", "kind", "status", "observedAt"],
      "properties": {
        "operationId": { "type": "string", "minLength": 1 },
        "effectDigest": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["prepare", "archive"] },
        "status": { "enum": ["confirmed", "missing", "in-doubt", "failed"] },
        "result": { "oneOf": [{ "$ref": "#/$defs/capability" }, { "$ref": "#/$defs/archiveReceipt" }] },
        "blocker": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
