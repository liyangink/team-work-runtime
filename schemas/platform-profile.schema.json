{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-work.local/schemas/platform-profile.schema.json",
  "title": "Team-work Platform Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "platform", "generatedAt", "agents", "dispatch", "operations", "limits", "session", "ui", "degradations", "guides"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "platform": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tier", "requestedModel", "resolvedModel", "costWeight", "capabilities"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "tier": { "enum": ["junior", "senior", "expert"] },
          "requestedModel": { "type": "string", "minLength": 1 },
          "resolvedModel": { "type": ["string", "null"] },
          "costWeight": { "type": "number", "exclusiveMinimum": 0 },
          "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "helpers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "resolvedModel", "capabilities"],
        "properties": {
          "id": { "enum": ["team-work-explore", "team-work-librarian"] },
          "kind": { "enum": ["explore", "librarian"] },
          "resolvedModel": { "type": ["string", "null"] },
          "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      },
      "maxItems": 2,
      "uniqueItems": true
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["managedMode", "blockingPolicy"],
      "properties": {
        "managedMode": { "enum": ["background", "blocking"] },
        "blockingPolicy": { "enum": ["allow", "reject", "rewrite-background"] }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spawn", "assign", "resume", "status", "stop", "message"],
      "properties": {
        "spawn": { "$ref": "#/$defs/operation" },
        "assign": { "$ref": "#/$defs/operation" },
        "resume": { "$ref": "#/$defs/operation" },
        "status": { "$ref": "#/$defs/operation" },
        "stop": { "$ref": "#/$defs/operation" },
        "message": { "$ref": "#/$defs/operation" },
        "assist": { "$ref": "#/$defs/operation" },
        "assistStatus": { "$ref": "#/$defs/operation" },
        "assistCollect": { "$ref": "#/$defs/operation" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxConcurrent"],
      "properties": { "maxConcurrent": { "type": ["integer", "null"], "minimum": 1 } }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["childSessions", "resume", "crossSessionProcessRecovery"],
      "properties": {
        "childSessions": { "type": "boolean" },
        "resume": { "type": "boolean" },
        "crossSessionProcessRecovery": { "type": "boolean" }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["childNavigation", "splitView"],
      "properties": {
        "childNavigation": { "type": "boolean" },
        "splitView": { "type": "boolean" }
      }
    },
    "degradations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "description"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "guides": { "type": "array", "items": { "$ref": "#/$defs/projectPath" }, "uniqueItems": true }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "tool"],
      "properties": {
        "supported": { "type": "boolean" },
        "tool": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "supported": { "const": true } }, "required": ["supported"] },
          "then": { "properties": { "tool": { "type": "string", "minLength": 1 } } },
          "else": { "properties": { "tool": { "type": "null" } } }
        }
      ]
    },
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
