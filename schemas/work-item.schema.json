{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-work.local/schemas/work-item.schema.json",
  "title": "Team-work Work Item",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workItemId", "taskId", "stage", "stageRun", "owner", "status", "attempt", "attemptHistory", "assignment", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.1" },
    "workItemId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "taskId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "stage": { "type": "string", "minLength": 1 },
    "stageRun": { "type": "integer", "minimum": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "status": { "enum": ["queued", "running", "submitted", "accepted", "rework", "blocked", "cancelled"] },
    "attempt": { "type": "integer", "minimum": 1 },
    "attemptHistory": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["attempt", "submission", "acceptance"],
            "properties": {
              "attempt": { "type": "integer", "minimum": 1 },
              "submission": { "$ref": "#/$defs/submission" },
              "acceptance": { "$ref": "#/$defs/historyAcceptance" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["attempt", "owner", "blockage"],
            "properties": {
              "attempt": { "type": "integer", "minimum": 1 },
              "owner": { "type": "string", "minLength": 1 },
              "blockage": { "$ref": "#/$defs/blockage" }
            }
          }
        ]
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "doneWhen", "artifactPaths", "dependencies"],
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "doneWhen": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "artifactPaths": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/projectPath" }, "uniqueItems": true },
        "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "submission": { "$ref": "#/$defs/submission" },
    "acceptance": { "$ref": "#/$defs/acceptance" },
    "blockage": { "$ref": "#/$defs/blockage" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["submitted", "accepted", "rework"] } }, "required": ["status"] },
      "then": { "required": ["submission"] }
    },
    {
      "if": { "properties": { "status": { "enum": ["accepted", "rework"] } }, "required": ["status"] },
      "then": { "required": ["acceptance"] }
    },
    {
      "if": { "properties": { "status": { "enum": ["queued", "running", "blocked"] } }, "required": ["status"] },
      "then": { "not": { "anyOf": [{ "required": ["submission"] }, { "required": ["acceptance"] }] } }
    },
    {
      "if": { "properties": { "status": { "const": "submitted" } }, "required": ["status"] },
      "then": { "not": { "required": ["acceptance"] } }
    },
    {
      "if": { "properties": { "status": { "const": "blocked" } }, "required": ["status"] },
      "then": { "required": ["blockage"] }
    },
    {
      "if": { "properties": { "status": { "enum": ["queued", "running", "submitted", "accepted", "rework"] } }, "required": ["status"] },
      "then": { "not": { "required": ["blockage"] } }
    },
    {
      "if": { "properties": { "status": { "const": "cancelled" } }, "required": ["status"] },
      "then": {
        "oneOf": [
          { "not": { "anyOf": [{ "required": ["submission"] }, { "required": ["acceptance"] }] } },
          {
            "required": ["submission", "acceptance"],
            "properties": {
              "acceptance": { "type": "object", "properties": { "decision": { "const": "rework" } } }
            }
          }
        ]
      }
    },
    {
      "if": { "properties": { "status": { "const": "accepted" } }, "required": ["status"] },
      "then": {
        "properties": {
          "acceptance": { "type": "object", "properties": { "decision": { "const": "accepted" } } }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "rework" } }, "required": ["status"] },
      "then": {
        "properties": {
          "acceptance": { "type": "object", "properties": { "decision": { "const": "rework" } } }
        }
      }
    }
  ],
  "$defs": {
    "blockage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "reason", "refs", "owner", "blockedAt"],
      "properties": {
        "kind": { "const": "infrastructure" },
        "code": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "owner": { "type": "string", "minLength": 1 },
        "blockedAt": { "type": "string", "format": "date-time" }
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario", "stageRef", "scopeRefs", "outcome", "artifactRefs", "evidenceRefs", "summary", "submittedAt"],
      "properties": {
        "scenario": { "type": "string", "minLength": 1 },
        "stageRef": { "type": "string", "minLength": 1 },
        "scopeRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "outcome": { "enum": ["pass", "rework", "blocked", "degraded"] },
        "artifactRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/projectPath" }, "uniqueItems": true },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "summary": { "type": "string", "minLength": 1 },
        "submittedAt": { "type": "string", "format": "date-time" }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptedBy", "acceptedAt", "decision", "evidenceRefs"],
      "properties": {
        "acceptedBy": { "type": "string", "minLength": 1 },
        "acceptedAt": { "type": "string", "format": "date-time" },
        "decision": { "enum": ["accepted", "rework"] },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "historyAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptedBy", "acceptedAt", "decision", "evidenceRefs"],
      "properties": {
        "acceptedBy": { "type": "string", "minLength": 1 },
        "acceptedAt": { "type": "string", "format": "date-time" },
        "decision": { "const": "rework" },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
