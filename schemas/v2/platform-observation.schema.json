{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-work-runtime.dev/schemas/v2/platform-observation",
  "$defs": {
    "observation": {
      "oneOf": [
        { "$ref": "#/$defs/executionObservation" },
        { "$ref": "#/$defs/checkObservation" }
      ]
    },
    "executionObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "observationId", "dedupeKey", "executionRef", "assignmentId", "state", "observedAt"],
      "properties": {
        "kind": { "const": "execution" },
        "observationId": { "type": "string", "minLength": 1 },
        "dedupeKey": { "type": "string", "minLength": 1 },
        "executionRef": { "type": "string", "minLength": 1 },
        "assignmentId": { "type": "string", "minLength": 1 },
        "state": { "enum": ["running", "idle", "error", "lost"] },
        "observedAt": { "type": "string", "format": "date-time" },
        "error": { "$ref": "#/$defs/platformError" }
      }
    },
    "checkObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "observationId", "dedupeKey", "executionRef", "assignmentId", "toolCallRef", "commandSummary", "result", "observedAt"],
      "properties": {
        "kind": { "const": "check" },
        "observationId": { "type": "string", "minLength": 1 },
        "dedupeKey": { "type": "string", "minLength": 1 },
        "executionRef": { "type": "string", "minLength": 1 },
        "assignmentId": { "type": "string", "minLength": 1 },
        "toolCallRef": { "type": "string", "minLength": 1 },
        "commandSummary": { "type": "string", "minLength": 1 },
        "exitCode": { "type": "integer" },
        "result": { "enum": ["pass", "fail", "unknown"] },
        "outputRef": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "platformError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "retryable", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observationId", "sequence", "duplicate"],
      "properties": {
        "observationId": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 1 },
        "duplicate": { "type": "boolean" }
      }
    }
  }
}
