{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-work-runtime.dev/schemas/v2/common",
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "locator": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "value"],
              "properties": {
                "type": { "const": "project-path" },
                "value": { "$ref": "#/$defs/projectPath" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "value"],
              "properties": {
                "type": { "const": "git-revision" },
                "value": { "type": "string", "minLength": 1 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "value"],
              "properties": {
                "type": { "const": "external-uri" },
                "value": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "summary": { "type": "string" }
      }
    },
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "nonEmptyStrings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
