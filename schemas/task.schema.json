{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-work.local/schemas/task.schema.json",
  "title": "Team-work Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "workflow", "status", "stage", "entryStage", "revision", "spec", "teamDecision", "gates", "evidence", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "taskId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "path", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/projectPath" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "status": { "enum": ["active", "awaiting-user", "completed", "cancelled"] },
    "stage": { "type": "string", "minLength": 1 },
    "entryStage": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "artifactRefs", "configDigest"],
      "properties": {
        "status": { "enum": ["not-started", "in-progress", "completed", "blocked", "disabled"] },
        "artifactRefs": { "type": "array", "items": { "$ref": "#/$defs/projectPath" }, "uniqueItems": true },
        "configDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "teamDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["undecided", "solo", "team"] },
        "reason": { "type": "string" }
      }
    },
    "awaitingUser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "blocker", "requiredDecision", "requestedAt"],
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "blocker": { "type": "string", "minLength": 1 },
        "requiredDecision": { "type": "string", "minLength": 1 },
        "gateRef": { "type": "string", "minLength": 1 },
        "requestedAt": { "type": "string", "format": "date-time" }
      }
    },
    "gates": {
      "type": "array",
      "items": { "$ref": "#/$defs/gate" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "acceptance": { "$ref": "#/$defs/acceptance" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
      "then": { "required": ["acceptance"] }
    },
    {
      "if": { "properties": { "status": { "const": "awaiting-user" } }, "required": ["status"] },
      "then": { "required": ["awaitingUser"] },
      "else": { "not": { "required": ["awaitingUser"] } }
    }
  ],
  "$defs": {
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "digest": { "type": "string", "pattern": "^[a-z0-9]+:[A-Fa-f0-9]+$" },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateId", "stage", "kind", "status", "evidenceRefs"],
      "properties": {
        "gateId": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["deterministic", "semantic", "human"] },
        "status": { "enum": ["pending", "passed", "blocked", "overridden"] },
        "blocker": { "type": "string", "minLength": 1 },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decidedBy", "reason", "decidedAt"],
          "properties": {
            "decidedBy": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1 },
            "decidedAt": { "type": "string", "format": "date-time" }
          }
        },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["blocked", "overridden"] } }, "required": ["status"] },
          "then": { "required": ["blocker"] }
        },
        {
          "if": { "properties": { "status": { "enum": ["passed", "overridden"] } }, "required": ["status"] },
          "then": {
            "required": ["decision"],
            "properties": { "evidenceRefs": { "type": "array", "minItems": 1 } }
          }
        },
        {
          "if": { "properties": { "status": { "const": "pending" } }, "required": ["status"] },
          "then": {
            "properties": { "evidenceRefs": { "type": "array", "maxItems": 0 } },
            "not": { "anyOf": [{ "required": ["blocker"] }, { "required": ["decision"] }] }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "stage", "path", "status", "recordedAtRevision"],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/projectPath" },
        "status": { "enum": ["valid", "invalidated"] },
        "recordedAtRevision": { "type": "integer", "minimum": 0 },
        "invalidatedAtRevision": { "type": "integer", "minimum": 1 },
        "invalidationReason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "invalidated" } }, "required": ["status"] },
          "then": { "required": ["invalidatedAtRevision", "invalidationReason"] }
        }
      ]
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptedBy", "acceptedAt", "summary", "artifactRefs", "evidenceRefs"],
      "properties": {
        "acceptedBy": { "type": "string", "minLength": 1 },
        "acceptedAt": { "type": "string", "format": "date-time" },
        "summary": { "type": "string", "minLength": 1 },
        "artifactRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/projectPath" }, "uniqueItems": true },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    }
  }
}
