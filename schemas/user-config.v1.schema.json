{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-work.local/schemas/user-config.v1.schema.json",
  "title": "Team-work User Config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "agents", "platforms", "spec"],
  "properties": {
    "$schema": { "const": "./schemas/user-config.v1.schema.json" },
    "agents": {
      "oneOf": [
        { "const": "auto" },
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "additionalProperties": { "$ref": "#/$defs/agent" }
        }
      ]
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opencode"],
      "properties": {
        "opencode": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "command": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "mode"],
      "properties": {
        "provider": { "const": "openspec" },
        "mode": { "enum": ["auto", "required", "disabled"] },
        "command": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model"],
      "properties": {
        "model": { "type": "string", "pattern": "^[^\\s/]+/.+$" },
        "effort": { "type": "string", "minLength": 1 },
        "role": { "enum": ["junior", "senior", "expert", "challenger", "assistant"] }
      }
    }
  }
}
