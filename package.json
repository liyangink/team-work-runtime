{
  "name": "team-work-runtime",
  "version": "0.2.1-beta.2",
  "description": "平台无关的多智能体研发 Harness：任务目录即状态，工具调用即检查点，门只在阶段流转",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liyangink/team-work-runtime.git"
  },
  "homepage": "https://github.com/liyangink/team-work-runtime#readme",
  "bugs": "https://github.com/liyangink/team-work-runtime/issues",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./dsh/client/badge.js",
    "./bin/tw.mjs": "./bin/tw.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "tw": "bin/tw.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:v3": "node --test tests/runtime-v3-*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "files": [
    "bin/",
    "cordis.patch.yml",
    "dsh/",
    "runtime-v3/",
    "policy/",
    "workflow/definitions/",
    "team-work/policies/",
    "team-work/guidance/",
    "spec-providers/",
    "skills/team-work-v3/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "multiagent",
    "workflow",
    "dsh",
    "ai-agent"
  ],
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.0-rc",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc"
  }
}
