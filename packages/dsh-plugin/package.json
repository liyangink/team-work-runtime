{
  "name": "team-work-runtime-dsh",
  "version": "0.1.0-beta.1",
  "description": "team-work-runtime 的 DSH 平台绑定插件：成员模型/effort 注入、skill 注册、tw 原生工具、子代理模型席位徽标",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src-client/badge.js"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "files": [
    "src/",
    "src-client/",
    "dist/skill/",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.0-rc"
  },
  "engines": { "node": ">=18" }
}
