{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-work-runtime.dev/schemas/v2/team-policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "version", "costWeights", "automaticLimits", "maxAutonomousRounds", "concurrencySoftLimit", "scenes", "e2eTemplate"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "policyId": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "minLength": 1 },
    "costWeights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["junior", "senior", "expert"],
      "properties": {
        "junior": { "const": 1 },
        "senior": { "const": 10 },
        "expert": { "const": 50 }
      }
    },
    "automaticLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["economy", "balanced", "quality"],
      "properties": {
        "economy": { "type": "number", "minimum": 1 },
        "balanced": { "type": "number", "minimum": 1 },
        "quality": { "type": "number", "minimum": 1 }
      }
    },
    "maxAutonomousRounds": { "const": 3 },
    "concurrencySoftLimit": { "type": "integer", "minimum": 1 },
    "scenes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/scene" }
    },
    "e2eTemplate": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workPackage" }
    }
  },
  "$defs": {
    "tier": { "enum": ["junior", "senior", "expert"] },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerTier", "challengerTier", "core"],
      "properties": {
        "ownerTier": { "$ref": "#/$defs/tier" },
        "challengerTier": { "enum": ["senior", "expert"] },
        "core": { "type": "boolean" },
        "requiredPerspectives": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/nonEmptyStrings" }
      }
    },
    "workPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageId", "assignmentKind", "outputRefs", "dependsOn", "completionCriteria"],
      "properties": {
        "packageId": { "$ref": "#/$defs/id" },
        "assignmentKind": { "type": "string", "minLength": 1 },
        "outputRefs": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/nonEmptyStrings" },
        "dependsOn": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/nonEmptyStrings" },
        "completionCriteria": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/nonEmptyStrings" }
      }
    },
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$" }
  }
}
