{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-work-runtime.dev/schemas/v2/stage-plan-proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposalId", "stageRunId", "stage", "integrationRequired", "workPackages", "digest"],
  "properties": {
    "proposalId": { "$ref": "#/$defs/id" },
    "stageRunId": { "$ref": "#/$defs/id" },
    "stage": { "$ref": "#/$defs/id" },
    "integrationRequired": { "type": "boolean" },
    "workPackages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["packageId", "objective", "inputRefs", "outputRefs", "completionCriteria", "dependsOn"],
        "properties": {
          "packageId": { "$ref": "#/$defs/id" },
          "objective": { "type": "string", "minLength": 1 },
          "assignmentKind": { "type": "string", "minLength": 1 },
          "inputRefs": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/nonEmptyStrings" },
          "outputRefs": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/nonEmptyStrings" },
          "completionCriteria": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/nonEmptyStrings" },
          "dependsOn": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/nonEmptyStrings" }
        }
      }
    },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
