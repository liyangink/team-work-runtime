{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-work-runtime.dev/schemas/v2/decision-packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["packetId", "question", "stage", "roster", "claims", "rounds", "artifactRefs", "choices"],
  "properties": {
    "packetId": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "stage": { "type": "string", "minLength": 1 },
    "roster": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["memberRef", "role", "assignmentKind", "tier", "status"],
        "properties": {
          "memberRef": { "type": "string", "minLength": 1 },
          "role": { "enum": ["owner", "challenger", "expert"] },
          "assignmentKind": { "type": "string", "pattern": "^(planning|research|design|spec|implementation|integration|test|review|e2e|evidence|custom:.+)$" },
          "tier": { "enum": ["junior", "senior", "expert"] },
          "modelLabel": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authorRef", "statement", "evidenceRefs"],
        "properties": {
          "authorRef": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["round", "outcome", "resolved", "unresolved"],
        "properties": {
          "round": { "type": "integer", "minimum": 1, "maximum": 3 },
          "outcome": { "type": "string", "minLength": 1 },
          "resolved": { "type": "array", "items": { "type": "string" } },
          "unresolved": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "expertVerdictRef": { "type": "string", "minLength": 1 },
    "ownerResponseRef": { "type": "string", "minLength": 1 },
    "artifactRefs": { "type": "array", "items": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/projectPath" }, "uniqueItems": true },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "label"],
        "properties": {
          "value": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "impact": { "type": "string" },
          "relativeCost": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
