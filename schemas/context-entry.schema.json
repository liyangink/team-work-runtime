{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-work.local/schemas/context-entry.schema.json",
  "title": "Team-work Context Entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contextId", "taskId", "path", "kind", "profiles", "priority", "mustRead", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "contextId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "taskId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "kind": { "enum": ["requirement", "source", "review-scope", "test-scope", "spec", "design", "test", "review", "artifact", "evidence"] },
    "profiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["lead", "research", "implement", "check"] } },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
    "mustRead": { "type": "boolean" },
    "summary": { "type": "string" },
    "digest": { "type": "string", "pattern": "^[a-z0-9]+:[A-Fa-f0-9]+$" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
