{
  "name": "team-work-runtime",
  "version": "0.1.0-beta.1",
  "description": "平台无关的 multiagent engineering loop 与 PlatformPlugin 安装器",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liyangink/team-work-runtime.git"
  },
  "homepage": "https://github.com/liyangink/team-work-runtime#readme",
  "bugs": {
    "url": "https://github.com/liyangink/team-work-runtime/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "team-work": "cli.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "prepublishOnly": "npm test",
    "test:contract": "node --test tests/runtime-v2-contract.test.mjs",
    "test:runtime": "node --test tests/runtime-v2-*.test.mjs",
    "test:policy": "node --test tests/policy-skills.test.mjs",
    "test:opencode": "node --test tests/opencode-*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "files": [
    "cli.mjs",
    "installer/",
    "runtime/",
    "policy/",
    "workflow/",
    "team-work/",
    "spec-providers/",
    "schemas/",
    "skills/workflow/",
    "skills/team-work/",
    "plugins/opencode/assets/",
    "plugins/opencode/adapter/",
    "plugins/opencode/context/",
    "plugins/opencode/config/",
    "plugins/opencode/guides/",
    "plugins/opencode/src/",
    "plugins/opencode/tools/",
    "plugins/opencode/tui/"
  ],
  "keywords": [
    "multiagent",
    "workflow",
    "opencode",
    "ai-agent"
  ],
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.0",
    "@opentui/core": "0.4.5",
    "@opentui/solid": "0.4.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsonc-parser": "^3.3.1",
    "solid-js": "1.9.12"
  }
}
