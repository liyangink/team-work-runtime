{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-work-runtime.dev/schemas/v2/member-delivery",
  "$defs": {
    "memberReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "summary", "artifacts", "evidenceRefs", "recommendation"],
      "properties": {
        "outcome": { "enum": ["delivered", "rework", "blocked", "needs-user"] },
        "summary": { "type": "string", "minLength": 1 },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "path"],
            "properties": {
              "ref": { "type": "string", "pattern": "^artifact:[a-zA-Z0-9][a-zA-Z0-9._:-]*$" },
              "path": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/projectPath" }
            }
          }
        },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "unresolved": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "result"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "result": { "enum": ["pass", "fail", "not-run"] },
              "evidenceRef": { "type": "string", "minLength": 1 }
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["severity", "statement", "evidenceRefs"],
            "properties": {
              "severity": { "enum": ["info", "risk", "blocker"] },
              "statement": { "type": "string", "minLength": 1 },
              "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
            }
          }
        },
        "recommendation": { "enum": ["accept", "rework", "escalate"] },
        "workflowOutcome": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "verdict": { "$ref": "https://team-work-runtime.dev/schemas/v2/expert-verdict" }
      }
    },
    "memberReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reportId", "observationId", "assignmentId", "accepted", "duplicate", "stateRevision"],
      "properties": {
        "reportId": { "type": "string", "minLength": 1 },
        "observationId": { "type": "string", "minLength": 1 },
        "assignmentId": { "type": "string", "minLength": 1 },
        "accepted": { "type": "boolean" },
        "duplicate": { "type": "boolean" },
        "stateRevision": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
