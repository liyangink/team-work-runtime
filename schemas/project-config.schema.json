{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-work.local/schemas/project-config.schema.json",
  "title": "Team-work Project Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflow", "spec"],
  "properties": {
    "schemaVersion": { "const": "1.1" },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "path", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/projectPath" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "skill", "root", "mode", "status"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "skill": { "type": "string", "minLength": 1 },
        "root": { "$ref": "#/$defs/projectPath" },
        "mode": { "enum": ["auto", "required", "disabled"] },
        "status": { "enum": ["ready", "missing", "disabled"] }
      }
    },
    "humanReview": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
      "additionalProperties": { "enum": ["required", "optional", "disabled"] }
    }
  },
  "$defs": {
    "projectPath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "digest": { "type": "string", "pattern": "^[a-z0-9]+:[A-Fa-f0-9]+$" }
  }
}
