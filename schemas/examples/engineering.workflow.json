{
  "schemaVersion": "1.0",
  "workflowId": "engineering",
  "version": "1.1",
  "initialStage": "research",
  "stages": [
    {
      "id": "research",
      "requiredInputs": [{ "kind": "requirement", "minCount": 1 }],
      "teamEvaluation": true,
      "terminal": false
    },
    {
      "id": "design",
      "requiredInputs": [{ "kind": "requirement", "minCount": 1 }],
      "teamEvaluation": true,
      "terminal": false
    },
    {
      "id": "design-review",
      "requiredInputs": [{ "kind": "design", "minCount": 1 }],
      "teamEvaluation": true,
      "terminal": false
    },
    {
      "id": "spec",
      "requiredInputs": [{ "kind": "design", "minCount": 1 }],
      "teamEvaluation": true,
      "terminal": false,
      "specRoute": true
    },
    {
      "id": "spec-review",
      "requiredInputs": [{ "kind": "spec", "minCount": 1 }],
      "teamEvaluation": true,
      "terminal": false
    },
    {
      "id": "implementation",
      "requiredInputs": [{ "kind": "requirement", "minCount": 1 }],
      "teamEvaluation": true,
      "terminal": false
    },
    {
      "id": "test",
      "requiredInputs": [{ "kind": "source", "minCount": 1 }],
      "teamEvaluation": true,
      "terminal": false
    },
    {
      "id": "code-review",
      "requiredInputs": [
        { "kind": "source", "minCount": 1 },
        { "kind": "review-scope", "minCount": 1 }
      ],
      "teamEvaluation": true,
      "terminal": false
    },
    {
      "id": "e2e",
      "requiredInputs": [
        { "kind": "source", "minCount": 1 },
        { "kind": "test-scope", "minCount": 1 }
      ],
      "teamEvaluation": true,
      "terminal": false
    },
    {
      "id": "finish",
      "requiredInputs": [],
      "teamEvaluation": false,
      "terminal": true
    }
  ],
  "transitions": [
    { "from": "research", "outcome": "pass", "to": "design" },
    { "from": "design", "outcome": "pass", "to": "design-review" },
    { "from": "design-review", "outcome": "pass", "to": "spec" },
    { "from": "design-review", "outcome": "rework", "to": "design" },
    { "from": "spec", "outcome": "pass", "to": "spec-review" },
    { "from": "spec-review", "outcome": "pass", "to": "implementation" },
    { "from": "spec-review", "outcome": "rework", "to": "spec" },
    { "from": "spec-review", "outcome": "fail", "to": "design" },
    { "from": "implementation", "outcome": "pass", "to": "test" },
    { "from": "test", "outcome": "pass", "to": "code-review" },
    { "from": "test", "outcome": "fail", "to": "implementation" },
    { "from": "code-review", "outcome": "pass", "to": "e2e" },
    { "from": "code-review", "outcome": "rework", "to": "implementation" },
    { "from": "code-review", "outcome": "fail", "to": "test" },
    { "from": "e2e", "outcome": "pass", "to": "finish" },
    { "from": "e2e", "outcome": "rework", "to": "test" },
    { "from": "e2e", "outcome": "fail", "to": "implementation" }
  ],
  "rollback": { "enabled": true, "requiresReason": true, "invalidatesLaterEvidence": true }
}
