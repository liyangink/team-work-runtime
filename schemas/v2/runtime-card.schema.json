{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-work-runtime.dev/schemas/v2/runtime-card",
  "oneOf": [
    { "$ref": "#/$defs/actionCard" },
    { "$ref": "#/$defs/problemCard" }
  ],
  "$defs": {
    "nextAction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "instruction"],
          "properties": {
            "kind": { "const": "plan" },
            "instruction": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "instruction"],
          "properties": {
            "kind": { "const": "run" },
            "instruction": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "question", "choices"],
          "properties": {
            "kind": { "const": "steer" },
            "question": { "type": "string", "minLength": 1 },
            "choices": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["value", "label"],
                "properties": {
                  "value": { "type": "string", "minLength": 1 },
                  "label": { "type": "string", "minLength": 1 },
                  "impact": { "type": "string" },
                  "relativeCost": { "type": "number", "minimum": 0 }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "instruction"],
          "properties": {
            "kind": { "const": "wait" },
            "instruction": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "none" } }
        }
      ]
    },
    "actionCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cardId", "task", "report", "next"],
      "properties": {
        "cardId": { "type": "string", "minLength": 1 },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title", "stage", "stageLabel", "status"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "stage": { "type": "string", "minLength": 1 },
            "stageLabel": { "type": "string", "minLength": 1 },
            "status": { "enum": ["needs-plan", "working", "awaiting-user", "blocked", "completed", "cancelled"] }
          }
        },
        "report": {
          "type": "object",
          "additionalProperties": false,
          "required": ["completed", "current", "conclusions", "artifacts", "risks"],
          "properties": {
            "completed": { "type": "array", "items": { "type": "string" } },
            "current": { "type": "string" },
            "conclusions": { "type": "array", "maxItems": 3, "items": { "type": "string" } },
            "artifacts": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "path", "kind"],
                "properties": {
                  "label": { "type": "string" },
                  "path": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/projectPath" },
                  "kind": { "type": "string", "minLength": 1 }
                }
              }
            },
            "risks": { "type": "array", "maxItems": 3, "items": { "type": "string" } },
            "disagreement": { "type": "string" },
            "team": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "owners", "challengerTier", "expert", "cost"],
              "properties": {
                "mode": { "enum": ["solo", "team"] },
                "owners": { "type": "integer", "minimum": 0 },
                "challengerTier": { "enum": ["senior", "expert"] },
                "expert": { "type": "boolean" },
                "cost": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["forecastMin", "forecastMax", "accrued", "nextWave", "automaticLimit"],
                  "properties": {
                    "forecastMin": { "type": "number", "minimum": 0 },
                    "forecastMax": { "type": "number", "minimum": 0 },
                    "accrued": { "type": "number", "minimum": 0 },
                    "nextWave": { "type": "number", "minimum": 0 },
                    "automaticLimit": { "type": "number", "minimum": 0 }
                  }
                }
              }
            }
          }
        },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "packetRef"],
          "properties": {
            "summary": { "type": "string", "minLength": 1 },
            "packetRef": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/projectPath" }
          }
        },
        "next": { "$ref": "#/$defs/nextAction" }
      }
    },
    "problemCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "impact", "next"],
      "properties": {
        "code": {
          "enum": [
            "TASK_SELECTION_REQUIRED",
            "PLAN_INVALID",
            "ACTION_STALE",
            "ENTRY_UNSATISFIED",
            "ROUTE_BLOCKED",
            "ROUTE_SKIPPED",
            "BUDGET_DECISION_REQUIRED",
            "EVIDENCE_CHANGED",
            "WORK_CHAIN_INCOMPLETE",
            "PLATFORM_UNAVAILABLE",
            "EXTERNAL_EFFECT_IN_DOUBT",
            "RECOVERY_REQUIRED",
            "HUMAN_DECISION_REQUIRED",
            "CONTEXT_BUDGET_EXCEEDED",
            "STATE_CORRUPT",
            "RUNTIME_MAJOR_MISMATCH"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "next": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "when"],
              "properties": {
                "kind": { "const": "run" },
                "when": { "type": "string", "minLength": 1 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "reason"],
              "properties": {
                "kind": { "const": "none" },
                "reason": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "diagnosticId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
