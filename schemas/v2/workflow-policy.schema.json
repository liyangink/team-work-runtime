{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-work-runtime.dev/schemas/v2/workflow-policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflowId", "version", "terminalStages", "gates", "stages", "edges"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "workflowId": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "minLength": 1 },
    "terminalStages": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/nonEmptyStrings" },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gateId", "stage", "requirement", "artifactKind"],
        "properties": {
          "gateId": { "$ref": "#/$defs/id" },
          "stage": { "$ref": "#/$defs/id" },
          "requirement": { "enum": ["required", "optional", "disabled"] },
          "artifactKind": { "$ref": "#/$defs/id" }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "requiredInputs", "outputs", "assignmentKind", "teamScene", "planning"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1 },
          "requiredInputs": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/nonEmptyStrings" },
          "outputs": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/nonEmptyStrings" },
          "assignmentKind": { "type": "string", "minLength": 1 },
          "teamScene": { "$ref": "#/$defs/id" },
          "planning": { "enum": ["conditional", "required"] },
          "route": { "enum": ["spec", "e2e"] }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "outcome"],
        "properties": {
          "from": { "$ref": "#/$defs/id" },
          "to": { "$ref": "#/$defs/id" },
          "outcome": { "$ref": "#/$defs/id" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$" }
  }
}
