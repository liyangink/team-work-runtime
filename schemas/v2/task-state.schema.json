{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-work-runtime.dev/schemas/v2/task-state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtimeMajor", "schemaVersion", "taskId", "revision", "title", "objective", "taskIntent", "taskIntentRevision", "taskIntentHistory",
    "workflow", "scope", "status", "currentStageRun", "stageRuns", "stagePlan", "preflight", "routeDecisions",
    "workGraph", "artifacts", "evidence", "acceptedReportRefs", "costLedger",
    "observationInbox", "pendingDecision", "decisionHistory", "pendingOperations", "specLifecycle", "createdAt", "updatedAt"
  ],
  "properties": {
    "runtimeMajor": { "const": 2 },
    "schemaVersion": { "const": "2.1" },
    "taskId": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 0 },
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "taskIntent": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/taskIntent" }] },
    "taskIntentRevision": { "type": "integer", "minimum": 0 },
    "taskIntentHistory": { "type": "array", "items": { "$ref": "#/$defs/taskIntentHistoryEntry" } },
    "workflow": { "$ref": "#/$defs/workflowPin" },
    "scope": { "$ref": "#/$defs/stageScope" },
    "status": { "enum": ["needs-plan", "working", "awaiting-user", "blocked", "completed", "cancelled"] },
    "currentStageRun": { "$ref": "#/$defs/stageRun" },
    "stageRuns": { "type": "array", "items": { "$ref": "#/$defs/stageRun" } },
    "stagePlan": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/stagePlan" }
      ]
    },
    "preflight": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/preflight" }
      ]
    },
    "routeDecisions": { "type": "array", "items": { "$ref": "#/$defs/routeDecision" } },
    "workGraph": { "$ref": "#/$defs/workGraph" },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "acceptedReportRefs": { "type": "array", "items": { "$ref": "#/$defs/acceptedReportRef" } },
    "costLedger": { "$ref": "#/$defs/costLedger" },
    "observationInbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nextSequence", "acknowledgedThrough", "items", "dedupe"],
      "properties": {
        "nextSequence": { "type": "integer", "minimum": 1 },
        "acknowledgedThrough": { "type": "integer", "minimum": 0 },
        "items": { "type": "array", "items": { "$ref": "#/$defs/observationItem" } },
        "dedupe": { "type": "array", "items": { "$ref": "#/$defs/observationDedupe" } }
      }
    },
    "pendingDecision": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/pendingDecision" }] },
    "decisionHistory": { "type": "array", "items": { "$ref": "#/$defs/resolvedDecision" } },
    "pendingOperations": { "type": "array", "items": { "$ref": "#/$defs/pendingOperation" } },
    "specLifecycle": { "$ref": "#/$defs/specLifecycle" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
    },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "taskIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "constraints", "exclusions", "preferences"],
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "constraints": { "$ref": "#/$defs/uniqueStrings" },
        "exclusions": { "$ref": "#/$defs/uniqueStrings" },
        "preferences": {
          "type": "object",
          "additionalProperties": false,
          "required": ["execution", "budget", "risk"],
          "properties": {
            "execution": { "enum": ["auto", "solo", "team"] },
            "budget": { "enum": ["economy", "balanced", "quality"] },
            "risk": { "enum": ["normal", "high", "critical"] }
          }
        }
      }
    },
    "taskIntentHistoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "intent", "stageRunId", "reason", "supersededAt"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "intent": { "$ref": "#/$defs/taskIntent" },
        "stageRunId": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1 },
        "supersededAt": { "type": "string", "format": "date-time" }
      }
    },
    "uniqueStrings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "workflowPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowId", "version", "digest"],
      "properties": {
        "workflowId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "completion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "workflow" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "stage"],
          "properties": {
            "mode": { "const": "through-stage" },
            "stage": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 }
      }
    },
    "stageScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryStage", "completion", "completionStages", "stages", "edges"],
      "properties": {
        "entryStage": { "type": "string", "minLength": 1 },
        "completion": { "$ref": "#/$defs/completion" },
        "completionStages": { "$ref": "#/$defs/uniqueStrings" },
        "stages": { "$ref": "#/$defs/uniqueStrings" },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
      }
    },
    "stageRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stageRunId", "sequence", "round", "stage", "status"],
      "properties": {
        "stageRunId": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "round": { "type": "integer", "minimum": 1 },
        "stage": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["planned", "dispatching", "waiting-reports", "reviewing", "ready-to-advance", "in-doubt", "rework", "completed"]
        },
        "reason": { "type": "string", "minLength": 1 },
        "completedAt": { "type": "string", "format": "date-time" }
      }
    },
    "stagePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planId", "stageRunId", "objective", "inputRefs", "outputRefs", "assignments", "basis", "teamMode", "policyPins", "convergence", "routes", "costProjection"],
      "properties": {
        "planId": { "$ref": "#/$defs/id" },
        "stageRunId": { "$ref": "#/$defs/id" },
        "objective": { "type": "string", "minLength": 1 },
        "inputRefs": { "$ref": "#/$defs/uniqueStrings" },
        "outputRefs": { "$ref": "#/$defs/uniqueStrings" },
        "assignments": { "$ref": "#/$defs/uniqueStrings" },
        "basis": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "deterministic" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "preflightId", "resultRef", "resultDigest"],
              "properties": {
                "kind": { "const": "preflight" },
                "preflightId": { "$ref": "#/$defs/id" },
                "resultRef": { "type": "string", "minLength": 1 },
                "resultDigest": { "$ref": "#/$defs/digest" }
              }
            }
          ]
        },
        "teamMode": { "enum": ["solo", "team"] },
        "policyPins": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflow", "team", "agentCatalogDigest"],
          "properties": {
            "workflow": { "$ref": "#/$defs/workflowPin" },
            "team": {
              "type": "object",
              "additionalProperties": false,
              "required": ["policyId", "version", "digest"],
              "properties": {
                "policyId": { "$ref": "#/$defs/id" },
                "version": { "type": "string", "minLength": 1 },
                "digest": { "$ref": "#/$defs/digest" }
              }
            },
            "agentCatalogDigest": { "$ref": "#/$defs/digest" }
          }
        },
        "convergence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxAutonomousRounds", "currentRound"],
          "properties": {
            "maxAutonomousRounds": { "const": 3 },
            "currentRound": { "type": "integer", "minimum": 1 }
          }
        },
        "costProjection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scopeStages", "branchPathCount", "specDecision", "e2eDecision", "maxAutonomousRounds"],
          "properties": {
            "scopeStages": { "$ref": "#/$defs/uniqueStrings" },
            "branchPathCount": { "type": "integer", "minimum": 0 },
            "specDecision": { "enum": ["use-provider", "skip", "block"] },
            "e2eDecision": { "enum": ["run", "skip", "block", "assessment-required"] },
            "maxAutonomousRounds": { "const": 3 }
          }
        },
        "routes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["humanGates", "spec", "e2e"],
          "properties": {
            "humanGates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["gateId", "stage", "artifactKind", "requirement", "action"],
                "properties": {
                  "gateId": { "$ref": "#/$defs/id" },
                  "stage": { "$ref": "#/$defs/id" },
                  "artifactKind": { "$ref": "#/$defs/id" },
                  "requirement": { "enum": ["required", "optional", "disabled"] },
                  "action": { "enum": ["wait", "skip"] },
                  "proofMode": { "enum": ["verified-event", "trusted-caller"] },
                  "reason": { "type": "string", "minLength": 1 }
                }
              }
            },
            "spec": { "$ref": "#/$defs/specRoute" },
            "e2e": { "$ref": "#/$defs/e2eRoute" }
          }
        },
        "intervention": { "$ref": "#/$defs/steeringIntervention" }
      }
    },
    "steeringIntervention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action", "directive", "targetRef", "referenceRefs", "sourceDecisionId", "sourcePacketRef",
        "sourcePacketDigest", "resumeDecisionId", "resumeQuestion", "resumeChoices", "requirement", "proofMode", "artifactIds"
      ],
      "properties": {
        "action": { "enum": ["owner-rework", "collect-evidence", "expert-arbitrate"] },
        "directive": { "type": "string", "minLength": 1 },
        "targetRef": { "type": "string", "minLength": 1 },
        "referenceRefs": { "$ref": "#/$defs/uniqueStrings" },
        "sourceDecisionId": { "$ref": "#/$defs/id" },
        "sourcePacketRef": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/projectPath" },
        "sourcePacketDigest": { "$ref": "#/$defs/digest" },
        "resumeDecisionId": { "$ref": "#/$defs/id" },
        "resumeQuestion": { "type": "string", "minLength": 1 },
        "resumeChoices": { "$ref": "#/$defs/uniqueStrings" },
        "requirement": { "enum": ["required", "optional"] },
        "proofMode": { "enum": ["verified-event", "trusted-caller"] },
        "artifactIds": { "$ref": "#/$defs/uniqueStrings" }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preflightId", "stageRunId", "kind", "status", "plan", "result"],
      "properties": {
        "preflightId": { "$ref": "#/$defs/id" },
        "stageRunId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["planning-bootstrap", "route-assessment"] },
        "status": { "enum": ["active", "satisfied", "consumed"] },
        "plan": { "$ref": "#/$defs/stagePlan" },
        "result": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "ref", "digest", "evidenceRefs"],
              "properties": {
                "kind": { "enum": ["planning-bootstrap", "route-assessment"] },
                "ref": { "type": "string", "minLength": 1 },
                "digest": { "$ref": "#/$defs/digest" },
                "evidenceRefs": { "$ref": "#/$defs/uniqueStrings" }
              }
            }
          ]
        }
      }
    },
    "specRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "configDigest", "probeDigest", "decision", "reason", "digest"],
      "properties": {
        "mode": { "enum": ["auto", "required", "disabled"] },
        "configDigest": { "$ref": "#/$defs/digest" },
        "probeDigest": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
        "decision": { "enum": ["use-provider", "skip", "block"] },
        "reason": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "routeDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionId", "stageRunId", "stage", "routeKind", "outcome", "decision", "routeDigest", "basisRefs", "reason", "recovery", "recordedAt"],
      "properties": {
        "decisionId": { "$ref": "#/$defs/id" },
        "stageRunId": { "$ref": "#/$defs/id" },
        "stage": { "$ref": "#/$defs/id" },
        "routeKind": { "enum": ["spec", "e2e"] },
        "outcome": { "enum": ["blocked", "skipped", "selected"] },
        "decision": { "enum": ["block", "skip", "run"] },
        "routeDigest": { "$ref": "#/$defs/digest" },
        "basisRefs": { "$ref": "#/$defs/uniqueStrings" },
        "reason": { "type": "string", "minLength": 1 },
        "recovery": { "enum": ["replan-after-capability-change", "follow-skip-edge", "follow-selected-edge"] },
        "routeSnapshot": { "$ref": "#/$defs/e2eRoute" },
        "recordedAt": { "type": "string", "format": "date-time" }
      }
    },
    "e2eRoute": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "mode", "userRequired", "taskIntentDigest", "artifactSnapshotDigest"],
          "properties": {
            "kind": { "const": "assessment-required" },
            "mode": { "enum": ["auto", "required", "disabled"] },
            "userRequired": { "type": "boolean" },
            "taskIntentDigest": { "$ref": "#/$defs/digest" },
            "artifactSnapshotDigest": { "$ref": "#/$defs/digest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "userRequired", "taskIntentDigest", "artifactSnapshotDigest", "assessmentDigest", "decision", "evidenceRefs", "reason", "digest"],
          "properties": {
            "mode": { "enum": ["auto", "required", "disabled"] },
            "userRequired": { "type": "boolean" },
            "taskIntentDigest": { "$ref": "#/$defs/digest" },
            "artifactSnapshotDigest": { "$ref": "#/$defs/digest" },
            "assessmentDigest": { "$ref": "#/$defs/digest" },
            "decision": { "enum": ["run", "skip", "block"] },
            "evidenceRefs": { "$ref": "#/$defs/uniqueStrings" },
            "reason": { "type": "string", "minLength": 1 },
            "digest": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attemptId", "attempt", "stageRunId", "status", "startedAt", "correctionCount"],
      "properties": {
        "attemptId": { "$ref": "#/$defs/id" },
        "attempt": { "type": "integer", "minimum": 1 },
        "stageRunId": { "$ref": "#/$defs/id" },
        "status": { "enum": ["effect-pending", "running", "reported", "verified", "accepted", "rework", "lost", "blocked", "in-doubt"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "correctionCount": { "type": "integer", "minimum": 0 },
        "idleObservedAt": { "type": "string", "format": "date-time" },
        "lastCorrectionAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "operationId": { "$ref": "#/$defs/id" },
        "effectDigest": { "$ref": "#/$defs/digest" },
        "receiptRef": { "$ref": "#/$defs/id" },
        "executionRef": { "type": "string", "minLength": 1 },
        "reportRef": { "$ref": "#/$defs/id" },
        "reportDigest": { "$ref": "#/$defs/digest" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "acceptedAt": { "type": "string", "format": "date-time" },
        "rejectedAt": { "type": "string", "format": "date-time" },
        "rejectionReason": { "type": "string", "minLength": 1 }
      }
    },
    "pendingOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "kind", "effectDigest", "status", "invocationCount", "intent", "createdAt"],
      "properties": {
        "operationId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["execution.ensure", "execution.stop", "execution.quiesce", "spec.prepare", "spec.archive"] },
        "assignmentId": { "$ref": "#/$defs/id" },
        "attemptId": { "$ref": "#/$defs/id" },
        "effectDigest": { "$ref": "#/$defs/digest" },
        "status": { "enum": ["intent-persisted", "in-doubt"] },
        "invocationCount": { "type": "integer", "minimum": 0 },
        "intent": { "type": "object" },
        "purpose": { "enum": ["dispatch", "continuation", "stop", "human-wait", "spec-prepare", "spec-archive"] },
        "lastError": { "$ref": "https://team-work-runtime.dev/schemas/v2/platform-observation#/$defs/platformError" },
        "invocationId": { "$ref": "#/$defs/id" },
        "leaseExpiresAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "specLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "capabilities", "status", "validation", "archive"],
      "properties": {
        "task": { "anyOf": [{ "type": "null" }, { "$ref": "https://team-work-runtime.dev/schemas/v2/spec-provider#/$defs/taskRef" }] },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact", "task", "operationId", "effectDigest", "receiptRef", "capabilityId", "capabilityDigest", "instructionsRef", "readableRefs", "writableRefs", "recordedAt"],
            "properties": {
              "artifact": { "enum": ["proposal", "design", "specs", "tasks"] },
              "capabilityNames": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "task": { "$ref": "https://team-work-runtime.dev/schemas/v2/spec-provider#/$defs/taskRef" },
              "operationId": { "$ref": "#/$defs/id" },
              "effectDigest": { "$ref": "#/$defs/digest" },
              "receiptRef": { "$ref": "#/$defs/id" },
              "capabilityId": { "type": "string", "minLength": 1 },
              "capabilityDigest": { "type": "string", "minLength": 1 },
              "instructionsRef": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/projectPath" },
              "readableRefs": { "type": "array", "items": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/projectPath" }, "uniqueItems": true },
              "writableRefs": { "type": "array", "items": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/projectPath" }, "uniqueItems": true },
              "recordedAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "status": { "anyOf": [{ "type": "null" }, { "$ref": "https://team-work-runtime.dev/schemas/v2/spec-provider#/$defs/status" }] },
        "validation": { "anyOf": [{ "type": "null" }, { "$ref": "https://team-work-runtime.dev/schemas/v2/spec-provider#/$defs/validation" }] },
        "archive": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["operationId", "effectDigest", "receiptRef", "archiveRefs", "observedAt"],
              "properties": {
                "operationId": { "$ref": "#/$defs/id" },
                "effectDigest": { "$ref": "#/$defs/digest" },
                "receiptRef": { "$ref": "#/$defs/id" },
                "archiveRefs": { "type": "array", "items": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/projectPath" }, "uniqueItems": true },
                "observedAt": { "type": "string", "format": "date-time" }
              }
            }
          ]
        }
      }
    },
    "pendingDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId", "stageRunId", "phase", "requirement", "proofMode",
        "capabilitySnapshotDigest", "leadBindingRef", "question", "choices",
        "evidence", "evidenceDigest", "executionRefs", "quiesceOperationId",
        "quiesceAttempt", "observationsAfterPrepare", "createdAt"
      ],
      "properties": {
        "decisionId": { "$ref": "#/$defs/id" },
        "stageRunId": { "$ref": "#/$defs/id" },
        "phase": { "enum": ["preparing", "awaiting-user"] },
        "requirement": { "enum": ["required", "optional"] },
        "proofMode": { "enum": ["verified-event", "trusted-caller"] },
        "capabilitySnapshotDigest": { "type": "string", "minLength": 1 },
        "leadBindingRef": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "choices": { "$ref": "#/$defs/uniqueStrings" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifactId", "path", "digest"],
            "properties": {
              "artifactId": { "$ref": "#/$defs/id" },
              "path": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/projectPath" },
              "digest": { "$ref": "#/$defs/digest" }
            }
          }
        },
        "evidenceDigest": { "$ref": "#/$defs/digest" },
        "executionRefs": { "$ref": "#/$defs/uniqueStrings" },
        "quiesceOperationId": { "$ref": "#/$defs/id" },
        "quiesceAttempt": { "type": "integer", "minimum": 1 },
        "observationsAfterPrepare": { "type": "integer", "minimum": 0 },
        "quiesceReceiptRef": { "$ref": "#/$defs/id" },
        "quiesceFailureRef": { "$ref": "#/$defs/id" },
        "afterHostCursor": { "type": "string", "minLength": 1 },
        "packetRef": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/projectPath" },
        "packetDigest": { "$ref": "#/$defs/digest" },
        "createdAt": { "type": "string", "format": "date-time" },
        "quiescedAt": { "type": "string", "format": "date-time" },
        "issuedAt": { "type": "string", "format": "date-time" }
      },
      "dependentRequired": {
        "packetRef": ["packetDigest"],
        "packetDigest": ["packetRef"]
      }
    },
    "resolvedDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId", "stageRunId", "choice", "proofMode", "leadBindingRef", "executionRefs", "artifactDigests",
        "evidenceDigest", "quiesceReceiptRef", "decisionRef", "decisionDigest", "receivedAt"
      ],
      "properties": {
        "decisionId": { "$ref": "#/$defs/id" },
        "stageRunId": { "$ref": "#/$defs/id" },
        "choice": { "type": "string", "minLength": 1 },
        "proofMode": { "enum": ["verified-event", "trusted-caller"] },
        "leadBindingRef": { "type": "string", "minLength": 1 },
        "executionRefs": { "$ref": "#/$defs/uniqueStrings" },
        "artifactDigests": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/digest" }
        },
        "evidenceDigest": { "$ref": "#/$defs/digest" },
        "quiesceReceiptRef": { "$ref": "#/$defs/id" },
        "decisionRef": { "$ref": "#/$defs/id" },
        "decisionDigest": { "$ref": "#/$defs/digest" },
        "packetRef": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/projectPath" },
        "packetDigest": { "$ref": "#/$defs/digest" },
        "receivedAt": { "type": "string", "format": "date-time" }
      },
      "dependentRequired": {
        "packetRef": ["packetDigest"],
        "packetDigest": ["packetRef"]
      }
    },
    "observationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observationId", "sequence", "dedupeKey", "digest", "kind", "progression", "receivedAt"],
      "properties": {
        "observationId": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "dedupeKey": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "kind": { "enum": ["member-report", "execution-running", "execution-idle", "execution-error", "execution-lost", "check-result", "human-message"] },
        "progression": { "enum": ["active", "deferred"] },
        "assignmentId": { "$ref": "#/$defs/id" },
        "attemptId": { "$ref": "#/$defs/id" },
        "executionRef": { "type": "string", "minLength": 1 },
        "payloadRef": { "type": "string", "minLength": 1 },
        "receivedAt": { "type": "string", "format": "date-time" }
      }
    },
    "observationDedupe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dedupeKey", "observationId", "sequence", "digest", "stateRevision"],
      "properties": {
        "dedupeKey": { "type": "string", "minLength": 1 },
        "observationId": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "stateRevision": { "type": "integer", "minimum": 1 }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignmentId", "teamRole", "assignmentKind", "costTier", "dependsOn",
        "readableRefs", "writableRefs", "completionCriteria", "execution", "status", "attempts"
      ],
      "properties": {
        "assignmentId": { "$ref": "#/$defs/id" },
        "teamRole": { "enum": ["owner", "challenger", "expert"] },
        "assignmentKind": {
          "type": "string",
          "pattern": "^(?:planning|research|design|spec|implementation|integration|test|review|e2e|evidence|e2e-applicability|custom:[a-z0-9][a-z0-9._-]*)$"
        },
        "costTier": { "enum": ["junior", "senior", "expert"] },
        "dependsOn": { "$ref": "#/$defs/uniqueStrings" },
        "readableRefs": { "$ref": "#/$defs/uniqueStrings" },
        "writableRefs": { "$ref": "#/$defs/uniqueStrings" },
        "completionCriteria": { "$ref": "#/$defs/uniqueStrings" },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agentId", "capabilitySnapshotDigest", "contextRef", "promptRef"],
          "properties": {
            "agentId": { "type": "string", "minLength": 1 },
            "capabilitySnapshotDigest": { "type": "string", "minLength": 1 },
            "contextRef": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/projectPath" },
            "promptRef": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/projectPath" },
            "resumeAssignmentId": { "$ref": "#/$defs/id" }
          }
        },
        "status": { "enum": ["planned", "effect-pending", "running", "reported", "verified", "accepted", "rework", "lost", "blocked", "in-doubt"] },
        "attempts": { "type": "array", "items": { "$ref": "#/$defs/attempt" } }
      }
    },
    "workGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignments"],
      "properties": {
        "assignments": { "type": "array", "items": { "$ref": "#/$defs/assignment" } }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "kind", "path", "digest", "stageRunId", "recordedAt"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/id" },
        "kind": { "type": "string", "minLength": 1 },
        "path": { "$ref": "https://team-work-runtime.dev/schemas/v2/common#/$defs/projectPath" },
        "digest": { "$ref": "#/$defs/digest" },
        "stageRunId": { "$ref": "#/$defs/id" },
        "recordedAt": { "type": "string", "format": "date-time" }
      }
    },
    "acceptedReportRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reportId", "digest"],
      "properties": {
        "reportId": { "$ref": "#/$defs/id" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "kind", "sourceRef", "artifactRefs", "artifactDigests", "result", "stageRunId", "observedAt", "valid"],
      "properties": {
        "evidenceId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["artifact-digest", "platform-check", "spec-provider", "human-decision", "external-fact", "member-assertion"] },
        "sourceRef": { "type": "string", "minLength": 1 },
        "artifactRefs": { "$ref": "#/$defs/uniqueStrings" },
        "artifactDigests": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/digest" }
        },
        "result": { "enum": ["pass", "fail", "unknown"] },
        "digest": { "$ref": "#/$defs/digest" },
        "stageRunId": { "$ref": "#/$defs/id" },
        "observedAt": { "type": "string", "format": "date-time" },
        "valid": { "type": "boolean" },
        "invalidation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "artifactId", "invalidatedAt"],
          "properties": {
            "reason": { "const": "artifact-changed" },
            "artifactId": { "$ref": "#/$defs/id" },
            "invalidatedAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    "costLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forecastMin", "forecastMax", "accrued", "uncertain", "nextWave", "automaticLimit"],
      "properties": {
        "forecastMin": { "type": "number", "minimum": 0 },
        "forecastMax": { "type": "number", "minimum": 0 },
        "accrued": { "type": "number", "minimum": 0 },
        "uncertain": { "type": "number", "minimum": 0 },
        "nextWave": { "type": "number", "minimum": 0 },
        "automaticLimit": { "type": "number", "minimum": 0 }
      }
    }
  }
}
