{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-work.local/schemas/workflow.schema.json",
  "title": "Team-work Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflowId", "version", "initialStage", "stages", "transitions", "rollback"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "workflowId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "initialStage": { "type": "string", "minLength": 1 },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requiredInputs", "teamEvaluation", "terminal"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "requiredInputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "minCount"],
              "properties": {
                "kind": { "enum": ["requirement", "source", "review-scope", "test-scope", "spec", "design", "test", "review", "artifact", "evidence"] },
                "minCount": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "teamEvaluation": { "type": "boolean" },
          "terminal": { "type": "boolean" },
          "specRoute": { "type": "boolean" }
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "outcome", "to"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "outcome": { "enum": ["pass", "rework", "fail"] },
          "to": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "requiresReason", "invalidatesLaterEvidence"],
      "properties": {
        "enabled": { "const": true },
        "requiresReason": { "const": true },
        "invalidatesLaterEvidence": { "const": true }
      }
    }
  }
}
